{
  "name": "chinese-learning-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "worker"
  ],
  "scripts": {
    "build": "npm run build --workspace=web && npm run build --workspace=worker",
    "build:web": "npm run build --workspace=web",
    "build:worker": "npm run build --workspace=worker",
    "dev:web": "npm run dev --workspace=web",
    "dev:worker": "npm run dev --workspace=worker",
    "deploy": "npm run build && wrangler deploy",
    "test": "npm run test --workspace=worker"
  },
  "devDependencies": {
    "wrangler": "^4.129.0"
  }
}
